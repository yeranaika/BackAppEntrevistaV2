# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/DBentrevista?currentSchema=app,public
DB_USER=postgres
DB_PASS=your_password_here
# Opcional: conexiones máximas del pool (por defecto 10)
DB_POOL_MAXIMO=10

# JWT Authentication
JWT_SECRET=your-secure-random-jwt-secret
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=app-entrevista

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# Google Play Billing
GOOGLE_PLAY_PACKAGE=com.appentrevista
GOOGLE_PLAY_SERVICE_JSON_B64=your_base64_encoded_service_account_json
GOOGLE_PLAY_BILLING_MOCK=true

# Redis (opcional, por defecto localhost:6379 sin contraseña)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / SMTP Configuration
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# External Job APIs (RapidAPI / JSearch)
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_API_KEY=your_rapidapi_key

# AI Question Generator (LLM APIs)
# Al menos una es necesaria para usar /api/v1/admin/preguntas/generar-ia (o el alias /api/v1/admin/questions/generate-ai).
# Cada modelo usa la clave de su proveedor: gpt-* → OpenAI, claude-* → Anthropic, mimo-* → Xiaomi MiMo (D30).
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Xiaomi MiMo (platform.xiaomimimo.com). MIMO_BASE_URL es opcional: por defecto https://api.xiaomimimo.com/v1
# (pago por uso); para el plan de tokens, la base que muestra la consola (https://…/v1). Solo https.
MIMO_API_KEY=your-mimo-api-key
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Token Plan de MiMo (D31): Credits por periodo y día del mes (1-28, UTC) en que se renueva. Sin CREDITOS, con una
# clave tp- se asume el plan Lite (4.100.000.000); 0 lo apaga y vuelve el tope en USD para los modelos mimo-*.
# MIMO_TOKEN_PLAN_CREDITOS=4100000000
# MIMO_TOKEN_PLAN_DIA_RENOVACION=1

# Tope mensual de reportes evaluados con IA por usuario premium (mes calendario UTC; 0 = sin IA; por defecto 30).
# Al llegar al tope el reporte sale igual, con el motor freemium.
LIMITE_EVALUACIONES_IA_MENSUAL=30

# Tope mensual de gasto estimado (USD) en generar preguntas con IA, sumando todos los admins y también las llamadas
# fallidas con tokens (mes calendario UTC; 0 = generación con IA desactivada; por defecto 5). Al llegar: 429 (D23).
LIMITE_GASTO_GENERACION_IA_MENSUAL_USD=5

# Límites por IP (por defecto 30 registros cada 10 min y 5 códigos de recuperación cada 15 min), compartidos en Redis
LIMITE_REGISTROS_POR_IP=30
LIMITE_RECUPERACIONES_POR_IP=5
# Generaciones de preguntas con IA por IP cada 60 min (por defecto 30; anti-ráfaga, el gasto lo frena el tope de arriba)
LIMITE_GENERACIONES_IA_POR_IP=30
# Cabecera con la IP real del cliente puesta por el proxy. En Railway: X-Real-IP, SOLO tras la prueba de humo
# (docs/04 Guias/Puesta en marcha.md). Vacía = la IP de la conexión. Nunca X-Forwarded-For.
CABECERA_IP_CLIENTE=

# Parecido (0 a 1) desde el cual una pregunta generada con IA se descarta por repetir otra del banco o del mismo lote
# (D45; por defecto 0.80; 0 = sin filtro). Con el filtro apagado tampoco se avisa de parecidas al crear/editar/aprobar.
UMBRAL_SIMILITUD_PREGUNTAS=0.80
# D49: proxy SOCKS5 de Tailscale para motor y WOL. En Railway lo exporta start.sh dentro del contenedor cuando
# TS_AUTHKEY conecta (no hace falta definirla a mano). Local: vacío = conexión directa.
MOTOR_SOCKS_PROXY=
# D49: auth key de Tailscale SOLO para el contenedor de Railway (secreto; nunca se imprime en logs).
# Vacío o ausente = el backend arranca sin Tailscale, como antes.
TS_AUTHKEY=
# Calibración del modelo de visión (D39): true monta POST /pruebas/video y GET /pruebas, que guardan .mp4 SIN sesión en
# la carpeta pruebas/ del servidor (la app los sube con -PgrabarPrueba=true). Solo el literal true la activa. Solo en
# local: en Railway el servidor no arranca con ella activa.
HABILITAR_PRUEBAS_VIDEO=false

# Tareas periódicas (D43): sincronización de mercado, rescate de reportes y purga de consentimientos. Solo "false" las
# apaga: úsalo en un backend LOCAL conectado a la BD compartida de Railway (mismo banco de preguntas para todo el equipo),
# para no rescatar reportes de usuarios reales ni llamar a las APIs de empleo desde tu PC. En Railway no arranca con false.
TAREAS_SEGUNDO_PLANO=true

# Apagado ordenado (D20): segundos que se espera a reportes y correos en curso (por defecto 150; máx. 600).
# Debe caber en el drenado de Railway (railway.json: drainingSeconds 200).
APAGADO_ESPERA_TAREAS_SEGUNDOS=150

# HTTP Freemium warm-up (0 disables it; default 2000)
FREEMIUM_HTTP_WARMUP=2000

# Motor de visión d37 (T3.11). Debe terminar en /predict (el cliente hace POST ahí; /health se deriva de la misma base).
# Local:   http://localhost:8094/predict
# Railway: http://100.94.73.121:8094/predict   (PC con GPU vía Tailscale)
MOTOR_ENDPOINT=http://localhost:8094/predict

# Despertar bajo demanda (D47). Vacío = deshabilitado. Si el motor no se alcanza (conexión/timeout) se hace
# POST a esta URL con la cabecera X-Wol-Token y se reintenta 3 veces (esperas 5-10-20 s). Máx. 1 envío por 60 s.
# Servicio WOL de la NUC (dentro de Tailscale): http://<ip-tailscale-nuc>:17474/wol
WOL_SERVICE_URL=
WOL_TOKEN=
