# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/DBentrevista?currentSchema=app,public
DB_USER=postgres
DB_PASS=your_password_here
# Opcional: conexiones máximas del pool (por defecto 10)
DB_POOL_MAXIMO=10

# JWT Authentication
JWT_SECRET=your-secure-random-jwt-secret
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=app-entrevista

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# Google Play Billing
GOOGLE_PLAY_PACKAGE=com.appentrevista
GOOGLE_PLAY_SERVICE_JSON_B64=your_base64_encoded_service_account_json
GOOGLE_PLAY_BILLING_MOCK=true

# Redis (opcional, por defecto localhost:6379 sin contraseña)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / SMTP Configuration
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# External Job APIs (RapidAPI / JSearch)
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_API_KEY=your_rapidapi_key

# AI Question Generator (LLM APIs)
# Al menos una de las dos es necesaria para usar /api/v1/admin/questions/generate-ai
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Tope mensual de reportes evaluados con IA por usuario premium (mes calendario UTC; 0 = sin IA; por defecto 30).
# Al llegar al tope el reporte sale igual, con el motor freemium.
LIMITE_EVALUACIONES_IA_MENSUAL=30

# Límites por IP (por defecto 30 registros cada 10 min y 5 códigos de recuperación cada 15 min), compartidos en Redis
LIMITE_REGISTROS_POR_IP=30
LIMITE_RECUPERACIONES_POR_IP=5
# Cabecera con la IP real del cliente puesta por el proxy. En Railway: X-Real-IP, SOLO tras la prueba de humo
# (docs/04 Guias/Puesta en marcha.md). Vacía = la IP de la conexión. Nunca X-Forwarded-For.
CABECERA_IP_CLIENTE=

# HTTP Freemium warm-up (0 disables it; default 2000)
FREEMIUM_HTTP_WARMUP=2000
