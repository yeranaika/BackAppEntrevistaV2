            "description": "Inicia el flujo OAuth web. Redirige a Google."
          },
          "response": []
        },
        {
          "name": "GET /auth/google/callback  (flujo web)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/google/callback", "host": ["{{baseUrl}}"], "path": ["auth","google","callback"] },
            "description": "Callback de Google. Devuelve TokenPair."
          },
          "response": []
        }
      ]
    },

