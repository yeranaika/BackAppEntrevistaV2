{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "EntrevistaAPP - API v2",
    "description": "Colección completa y ordenada. Login/Register guardan tokens automáticamente. Login Admin guarda adminToken. Variables: baseUrl, accessToken, refreshToken, adminToken, usuarioId, cargoId, skillId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://127.0.0.1:8080" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken",   "value": "" },
    { "key": "usuarioId",    "value": "" },
    { "key": "cargoId",      "value": "" },
    { "key": "skillId",      "value": "" }
  ],
  "item": [

    {
      "name": "00. Sistema",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Healthcheck. Responde OK si el servidor está vivo."
          },
          "response": []
        }
      ]
    },

    {
      "name": "01. Autenticación Local",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var d = pm.response.json();",
                  "    if (d.accessToken)  pm.collectionVariables.set('accessToken',  d.accessToken);",
                  "    if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"Password123\",\n  \"nombre\": \"Juan Pérez\",\n  \"idioma\": \"es\",\n  \"telefono\": \"+56912345678\",\n  \"fechaNacimiento\": \"1995-05-20\",\n  \"genero\": \"masculino\",\n  \"nivelExperiencia\": \"jr\",\n  \"area\": \"TI\",\n  \"pais\": \"CL\",\n  \"notaObjetivos\": \"Prepararme para entrevistas técnicas\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "description": "Registro de usuario. Guarda accessToken y refreshToken automáticamente."
          },
          "response": []
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var d = pm.response.json();",
                  "    if (d.accessToken)  pm.collectionVariables.set('accessToken',  d.accessToken);",
                  "    if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "description": "Login. Guarda accessToken y refreshToken automáticamente."
          },
          "response": []
        },
        {
          "name": "POST /auth/login (Admin) → guarda adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var d = pm.response.json();",
                  "    if (d.accessToken) pm.collectionVariables.set('adminToken', d.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "description": "Login con cuenta admin. Guarda el token en {{adminToken}}."
          },
          "response": []
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var d = pm.response.json();",
                  "    if (d.accessToken)  pm.collectionVariables.set('accessToken',  d.accessToken);",
                  "    if (d.refreshToken) pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
            "description": "Rotación de tokens. Invalida el anterior y emite un nuevo par."
          },
          "response": []
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] },
            "description": "Revoca el refreshToken. El accessToken expira solo (15 min)."
          },
          "response": []
        }
      ]
    },

    {
      "name": "02. Recuperación de Contraseña",
      "item": [
        {
          "name": "POST /auth/forgot-password  (envía OTP por email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"usuario@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth","forgot-password"] },
            "description": "Envía un código OTP de 6 dígitos al correo del usuario."
          },
          "response": []
        },
        {
          "name": "POST /auth/reset-password  (valida OTP y cambia)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usuario@example.com\",\n  \"codigo\": \"123456\",\n  \"nuevaContrasena\": \"NuevaPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth","reset-password"] },
            "description": "Valida el OTP y actualiza la contraseña."
          },
          "response": []
        },
        {
          "name": "POST /auth/change-password  (usuario autenticado) 🔒",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nuevaContrasena\": \"NuevaPassword456\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth","change-password"] },
            "description": "Cambio de contraseña con sesión activa (requiere JWT)."
          },
          "response": []
        },
        {
          "name": "POST /auth/request-reset  (dev: devuelve token+code)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"usuario@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/request-reset", "host": ["{{baseUrl}}"], "path": ["auth","request-reset"] },
            "description": "Solo para desarrollo. Devuelve el token y code en la respuesta (no manda email)."
          },
          "response": []
        },
        {
          "name": "POST /auth/confirm-reset  (dev: consume token+code)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<TOKEN_UUID_DEL_REQUEST_RESET>\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NuevaPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/confirm-reset", "host": ["{{baseUrl}}"], "path": ["auth","confirm-reset"] },
            "description": "Solo para desarrollo. Consume el token+code y setea la nueva contraseña."
          },
          "response": []
        }
      ]
    },

    {
      "name": "03. Google OAuth",
      "item": [
